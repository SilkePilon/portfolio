# Required in production — signs admin sessions. Generate: openssl rand -hex 32
PAYLOAD_SECRET=change-me-to-a-long-random-string

# Public URL of the site (absolute links in metadata / share images). Read at runtime.
SITE_URL=http://localhost:3000

# SQLite database file (Docker image default: file:/data/payload.db)
DATABASE_URI=file:./payload.db

# Upload directory (Docker image default: /data/media)
# MEDIA_DIR=./media

# Optional, build-time only: send contact-form submissions to an external endpoint instead of the CMS inbox.
# NEXT_PUBLIC_FORM_ENDPOINT=https://example.com/form
